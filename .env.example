# Local reviewed replay. Model-generated code requires the Docker sandbox.
PATCHLAB_HOST=127.0.0.1
PATCHLAB_PORT=4310
PATCHLAB_DATA=data
PATCHLAB_SANDBOX=local
DATABASE_URL=

# Empty local credentials are generated in the private data directory.
PATCHLAB_ADMIN_PASSWORD=
PATCHLAB_SESSION_SECRET=
PATCHLAB_SECURE_COOKIE=false

# Configure only when deliberately running a real model in Docker.
MODEL_API_TYPE=chat-completions
MODEL_ID=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_API_KEY_FILE=
MODEL_INPUT_PRICE=
MODEL_OUTPUT_PRICE=
